# Server Configuration
PORT=5000
NODE_ENV=production

# Database - MongoDB Atlas Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/team-task-manager?retryWrites=true&w=majority

# JWT Secret - Use a strong random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL - Your deployed frontend URL (for CORS)
CLIENT_URL=https://your-frontend-url.vercel.app
